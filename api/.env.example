# Copy to .env and fill every value. There are no defaults and no fallbacks
# for identity values (URLs, keys, provider names, model ids); they fail
# loudly when missing. Keep this file and .env in the same key order.

# Database (identity, required)
# Local dev: matches the docker-compose.yml postgres service at repo root.
DATABASE_URL=

# Document storage (algorithm parameter, documented default in app/config.py)
# DOCUMENT_STORAGE_DIR=

# Corpus embeddings (algorithm parameter, documented default in app/config.py)
# EMBEDDING_DIMENSIONS=

# Location of the shared schemas/ and rules/ directories (algorithm
# parameters, documented defaults in app/config.py). Defaults assume the
# process runs from api/ with schemas/ and rules/ as siblings of api/ at the
# repo root; override in Docker, where they are copied to fixed paths.
# SCHEMAS_DIR=
# RULES_DIR=

# OpenRouter (identity, required): the single gateway for every model call.
# Never name a model id or import a vendor client outside app/providers/.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=
