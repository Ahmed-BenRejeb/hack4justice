# Copy to .env and fill every value. There are no defaults and no fallbacks.
# Identity values (URLs, keys, provider names, model ids) fail loudly when missing.
# Keep this file and .env in the same key order.

# Database
DATABASE_URL=

# Session
SESSION_SECRET=

# Model provider (consumed only by lib/extraction/provider.ts)
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_ID=

# Demo
DEMO_SAFE=false
