# Copy to .env and fill every value. There are no defaults and no fallbacks.
# Identity values (URLs, keys, provider names, accounts) fail loudly when missing.
# Keep this file and .env in the same key order.

# Origin of the Python backend (api/), without the /api/v1 prefix
API_BASE_URL=

# Identifier recorded as officer_id on validate/flag decisions (no officer sign-in yet)
OFFICER_ID=
