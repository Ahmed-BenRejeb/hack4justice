# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored: it holds your IP and key path, not shared config.

admin_cidr      = "203.0.113.10/32" # your public IP; get it with `curl ifconfig.me`
public_key_path = "~/.ssh/id_ed25519.pub"

# Uncomment to override defaults:
# aws_region           = "eu-central-1"
# instance_type        = "c6i.xlarge"
# root_volume_size_gb  = 30
